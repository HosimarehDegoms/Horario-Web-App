VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — only needed for the Focus tab's "Connect to Spotify" feature.
# Create an app at https://developer.spotify.com/dashboard, add
# http://localhost:5173/spotify/callback (and your production URL's
# equivalent) as a Redirect URI, then paste its Client ID below. No client
# secret is needed — this app uses the PKCE OAuth flow.
VITE_SPOTIFY_CLIENT_ID=your-spotify-app-client-id
